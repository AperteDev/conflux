{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "cargo",
			"args": ["build"],
			"problemMatcher": ["$rustc"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "cargo build (whole workspace)"
		},
		{
			"label": "run",
			"type": "shell",
			"command": "cargo",
			"args": ["run", "--bin", "conflux", "--", "daemon"],
			"problemMatcher": ["$rustc"],
			"group": "none",
			"detail": "cargo run -- daemon (foreground; Ctrl+C to stop)"
		},
		{
			"label": "release: run the Release workflow",
			"type": "shell",
			"command": "gh",
			"args": ["workflow", "run", "release.yml", "-f", "version=${input:releaseVersion}"],
			"problemMatcher": [],
			"group": "none",
			"detail": "Start the Release workflow on GitHub: it sets the version, moves the Unreleased changelog section, builds, tags and publishes."
		}
	],
	"inputs": [
		{
			"id": "releaseVersion",
			"type": "promptString",
			"description": "Version to release, such as 1.1.0"
		}
	]
}
